{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregate overlapping hotel offers from two mock suppliers, dedupe, and select the best offer per hotel",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/temporal/worker.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@temporalio/activity": "^1.9.0",
    "@temporalio/client": "^1.9.0",
    "@temporalio/worker": "^1.9.0",
    "@temporalio/workflow": "^1.9.0",
    "dotenv": "^18.0.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
